+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+# ----------------------------------------------------------------------------
+# Copyright (c) 2026 gcw_Z57idahf.
+# This program is free software, you can redistribute it and/or modify it under the terms and conditions of
+# CANN Open Software License Agreement Version 2.0 (the "License").
+# Please refer to the License for details. You may not use this file except in compliance with the License.
+# THIS SOFTWARE IS PROVIDED ON AN "AS IS" BASIS, WITHOUT WARRANTIES OF ANY KIND, EITHER EXPRESS OR IMPLIED,
+# INCLUDING BUT NOT LIMITED TO NON-INFRINGEMENT, MERCHANTABILITY, OR FITNESS FOR A PARTICULAR PURPOSE.
+# See LICENSE in the root of the software repository for the full text of the License.
+# ----------------------------------------------------------------------------
+
+"""Run the production Bash merger and the production Python merge helper."""
+
+import json
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+TREE = Path(__file__).resolve().parents[3]
+SCRIPT = TREE / "scripts/util/merge_aicpu_info_json.sh"
+
+
+@unittest.skipUnless(
+    os.name == "posix", "The production merger requires Bash on Linux."
+)
+class TestAicpuMergeShell(unittest.TestCase):
+    def setUp(self):
+        self.temporary = tempfile.TemporaryDirectory(dir="/tmp")
+        self.addCleanup(self.temporary.cleanup)
+        self.root = Path(self.temporary.name)
+        self.top = self.root / "checkout"
+        self.top.symlink_to(TREE, target_is_directory=True)
+
+    def write(self, directory, name):
+        directory.mkdir(parents=True, exist_ok=True)
+        path = directory / (name + ".json")
+        path.write_text(
+            json.dumps({name: {"opInfo": {"engine": "DNN_VM_AICPU"}}}), encoding="utf-8"
+        )
+        return path
+
+    def invoke(self, root, output, *inputs):
+        return subprocess.run(
+            # Match the production script's Linux shebang. Paths are argv,
+            # never interpolated into a shell command or passed to bash -c.
+            ["/bin/bash", str(SCRIPT), str(root), str(output), *map(str, inputs)],
+            capture_output=True,
+            text=True,
+            shell=False,
+        )
+
+    def check_valid_paths(self, directory, top):
+        first = self.write(directory, "First")
+        second = self.write(directory, "Second")
+        output = directory / "merged.json"
+        result = self.invoke(top, output, first, second)
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        self.assertTrue(output.is_file(), result.stdout + result.stderr)
+        self.assertEqual(set(json.loads(output.read_text())), {"First", "Second"})
+
+    def test_input_and_output_directories_with_spaces(self):
+        self.check_valid_paths(self.root / "metadata with spaces", self.top)
+
+    def test_source_checkout_with_spaces(self):
+        top = self.root / "source checkout"
+        top.symlink_to(TREE, target_is_directory=True)
+        self.check_valid_paths(self.root / "normal", top)
+
+    def test_missing_later_input_is_a_failure(self):
+        first = self.write(self.root, "First")
+        result = self.invoke(
+            self.top, self.root / "merged.json", first, self.root / "absent.json"
+        )
+        self.assertNotEqual(result.returncode, 0, result.stdout + result.stderr)
+
+    def test_invalid_middle_input_is_not_masked_by_later_success(self):
+        first = self.write(self.root, "First")
+        broken = self.root / "broken.json"
+        broken.write_text("{", encoding="utf-8")
+        last = self.write(self.root, "Last")
+        result = self.invoke(self.top, self.root / "merged.json", first, broken, last)
+        self.assertNotEqual(result.returncode, 0, result.stdout + result.stderr)
+
+    def test_missing_first_input_remains_a_failure(self):
+        result = self.invoke(
+            self.top, self.root / "merged.json", self.root / "absent.json"
+        )
+        self.assertNotEqual(result.returncode, 0, result.stdout + result.stderr)
+
+    def test_valid_merge_without_spaces_remains_supported(self):
+        self.check_valid_paths(self.root, self.top)
+
+    def test_one_input_is_copied_unchanged(self):
+        first = self.write(self.root, "First")
+        output = self.root / "merged.json"
+        result = self.invoke(self.top, output, first)
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        self.assertEqual(output.read_bytes(), first.read_bytes())
+
+    def test_shell_characters_remain_literal_path_characters(self):
+        self.check_valid_paths(self.root / "metadata;$(printf literal)", self.top)
