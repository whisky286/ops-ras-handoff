+# INCLUDING BUT NOT LIMITED TO NON-INFRINGEMENT, MERCHANTABILITY, OR FITNESS FOR A PARTICULAR PURPOSE.
+# See LICENSE in the root of the software repository for the full text of the License.
+# ----------------------------------------------------------------------------
+
+import ast
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[3]
+BASH = shutil.which("bash")
+SCRIPT = ROOT / "scripts/util/gen_compile_option.sh"
+INI = (
+    "[FixtureOp]\ninput0.name=x\ninput0.paramType=required\ninput0.dtype=float32\n"
+    "input0.format=ND\noutput0.name=y\noutput0.paramType=required\noutput0.dtype=float32\n"
+    "output0.format=ND\nopFile.value=fixture_op\nopInterface.value=fixture_op\n"
+)
+
+
+@unittest.skipUnless(os.name == "posix" and BASH, "Linux Bash and Python required")
+class CompileOptionShellTests(unittest.TestCase):
+    def setUp(self):
+        temporary = tempfile.TemporaryDirectory(prefix="ras-options-", dir="/tmp")
+        self.addCleanup(temporary.cleanup)
+        self.temporary = Path(temporary.name)
+
+    def fixture(self, spaces=False):
+        root = self.temporary / ("project with spaces" if spaces else "project")
+        utilities = root / "scripts/util"
+        utilities.mkdir(parents=True)
+        for name in [
+            "gen_compile_option.sh",
+            "ascendc_impl_build.py",
+            "opdesc_parser.py",
+            "const_var.py",
+        ]:
+            shutil.copyfile(ROOT / "scripts/util" / name, utilities / name)
+        config = root / "scripts/kernel/binary_config"
+        config.mkdir(parents=True)
+        (config / "ascendc_config.json").write_text(
+            json.dumps({"ops": []}), encoding="utf-8"
+        )
+        kernel = root / "build/tbe/ascendc/fixture_op"
+        kernel.mkdir(parents=True)
+        (kernel / "fixture_op.cpp").write_text("// generator input\n", encoding="utf-8")
+        (root / "build/tbe/dynamic").mkdir()
+        autogen = root / "build/autogen"
+        autogen.mkdir()
+        (autogen / "custom_compile_options.ini").write_text("", encoding="utf-8")
+        (root / "build/tbe/config").mkdir()
+        return root
+
+    def configure(self, root, soc="ascend910b", invalid=False):
+        config = root / "build/tbe/config"
+        (config / f"aic-{soc}-ops-info.ini").write_text(INI, encoding="utf-8")
+        (config / f"kernel-options-{soc}.ini").write_text(
+            "[FixtureOp]\nauto_sync=true\noptions=-O2\n", encoding="utf-8"
+        )
+        if invalid:
+            output = root / "build/tbe/dynamic"
+            output.rmdir()
+            output.write_text("existing file blocks output directory", encoding="utf-8")
+
+    def invoke(self, root, *pairs):
+        env = {**os.environ, "PYTHONDONTWRITEBYTECODE": "1"}
+        env.pop("BUILD_BUILTIN_OPP", None)
+        return subprocess.run(
+            [BASH, str(root / "scripts/util/gen_compile_option.sh"), *pairs],
+            env=env,
+            capture_output=True,
+            text=True,
+            timeout=45,
+        )
+
+    def output(self, root):
+        return root / "build/tbe/dynamic/fixture_op.py"
+
+    def verify_generated(self, root, result):
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        path = self.output(root)
+        self.assertTrue(path.is_file(), result.stdout + result.stderr)
+        ast.parse(path.read_text(encoding="utf-8"))
+
+    def test_ordinary_path_still_generates_adapter(self):
+        root = self.fixture()
+        self.configure(root)
+        self.verify_generated(root, self.invoke(root, "FixtureOp:ascend910b"))
+
+    def test_space_path_generates_adapter(self):
+        root = self.fixture(spaces=True)
+        self.configure(root)
+        self.verify_generated(root, self.invoke(root, "FixtureOp:ascend910b"))
+
+    def test_space_path_with_two_socs(self):
+        root = self.fixture(spaces=True)
+        self.configure(root)
+        self.configure(root, "ascend950")
+        self.verify_generated(
+            root, self.invoke(root, "FixtureOp:ascend910b", "FixtureOp:ascend950")
+        )
+
+    def test_missing_config_returns_failure(self):
+        root = self.fixture()
+        result = self.invoke(root, "FixtureOp:ascend910b")
+        self.assertNotEqual(result.returncode, 0, result.stdout + result.stderr)
+        self.assertIn("not found", result.stdout)
+
+    def test_output_directory_collision_returns_failure(self):
+        root = self.fixture()
+        self.configure(root, invalid=True)
+        result = self.invoke(root, "FixtureOp:ascend910b")
+        self.assertNotEqual(result.returncode, 0, result.stdout + result.stderr)
+        self.assertIn("NotADirectoryError", result.stderr)
+
+    def test_missing_first_config_stops_before_later_success(self):
+        root = self.fixture()
+        self.configure(root, "ascend950")
+        result = self.invoke(root, "FixtureOp:ascend910b", "FixtureOp:ascend950")
+        self.assertNotEqual(result.returncode, 0, result.stdout + result.stderr)
+        self.assertFalse(self.output(root).exists())
+
+    def test_output_failure_stops_before_later_pair(self):
+        root = self.fixture()
+        self.configure(root, invalid=True)
+        self.configure(root, "ascend950")
+        result = self.invoke(root, "FixtureOp:ascend910b", "FixtureOp:ascend950")
+        self.assertNotEqual(result.returncode, 0, result.stdout + result.stderr)
+        self.assertFalse(self.output(root).exists())
+
+    def test_no_pairs_remains_success(self):
+        root = self.fixture()
+        self.assertEqual(self.invoke(root).returncode, 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
