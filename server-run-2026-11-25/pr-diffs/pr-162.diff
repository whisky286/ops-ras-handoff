+++ b/tests/ut/scripts/test_compile_option_shell.py
@@ -0,0 +1,148 @@
+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+# ----------------------------------------------------------------------------
+# Copyright (c) 2026 gcw_Z57idahf
