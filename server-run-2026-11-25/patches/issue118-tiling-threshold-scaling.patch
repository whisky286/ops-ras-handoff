+    // FIX (#118): log(k) clamp for K=1 and small-K threshold scaling.
+    // For K < kMin the threshold is scaled by sqrt(kMin / k) to compensate the
+    // underestimated statistical threshold. kMin is a fixed compile-time constant
+    // (no runtime environment knob).
+    {
+        constexpr float kMin = 512.0f;
+        tiling->compute.stdEstARowRatio =
+            1.0f / std::sqrt(2.0f * std::log(std::max(static_cast<float>(k), 2.0f)));
+        if (kMin > static_cast<float>(k) && tiling->compute.eMax > 0.0f) {
+            tiling->compute.eMax *= std::sqrt(kMin / static_cast<float>(k));
+        }
+    }
