+# INCLUDING BUT NOT LIMITED TO NON-INFRINGEMENT, MERCHANTABILITY, OR FITNESS FOR A PARTICULAR PURPOSE.
+# See LICENSE in the root of the software repository for the full text of the License.
+"""Execute the production OPC-info CSV CLI and compare regenerated files."""
+
+import csv
+import json
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+
+SCRIPT = (
+    Path(__file__).resolve().parents[3]
+    / "scripts/kernel/binary_script/gen_opcinfo_from_opinfo.py"
+)
+
+
+class TestOpcInfoCsvTruncation(unittest.TestCase):
+    def generate(self, root, ops, output):
+        source = root / "input.json"
+        source.write_text(json.dumps(ops), encoding="utf-8")
+        p = subprocess.run(
+            [sys.executable, str(SCRIPT), str(source), str(output)],
+            capture_output=True,
+            text=True,
+        )
+        self.assertEqual(p.returncode, 0, p.stdout + p.stderr)
+        return output.read_bytes()
+
+    def check_regeneration(self, new_ops):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            old = {
+                "OperatorWithLongName" + str(i): {
+                    "dynamicShapeSupport": {"flag": "true"}
+                }
+                for i in range(8)
+            }
+            self.generate(root, old, root / "output.csv")
+            actual = self.generate(root, new_ops, root / "output.csv")
+            expected = self.generate(root, new_ops, root / "fresh.csv")
+            self.assertEqual(actual, expected)
+            with (root / "output.csv").open(newline="", encoding="utf-8") as stream:
+                self.assertEqual(
+                    [row["op_type"] for row in csv.DictReader(stream)], list(new_ops)
+                )
+
+    def test_shorter_result_removes_previous_rows(self):
+        self.check_regeneration({"Add": {"dynamicShapeSupport": {"flag": "true"}}})
+
+    def test_empty_result_contains_only_header(self):
+        self.check_regeneration({})
+
+    def test_repeat_identical_result_is_stable(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            ops = {"Add": {"dynamicShapeSupport": {"flag": "true"}}}
+            self.assertEqual(
+                self.generate(root, ops, root / "output.csv"),
+                self.generate(root, ops, root / "output.csv"),
+            )
+
+    def test_multiple_inputs_and_dynamic_filter_remain_supported(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            for name, ops in [
+                (
+                    "first",
+                    {"Add": {"dynamicShapeSupport": {"flag": "true"}}, "Static": {}},
+                ),
+                ("second", {"Sub": {"dynamicShapeSupport": {"flag": "true"}}}),
+            ]:
+                (root / (name + ".json")).write_text(json.dumps(ops), encoding="utf-8")
+            output = root / "out.csv"
+            p = subprocess.run(
+                [
+                    sys.executable,
+                    str(SCRIPT),
+                    str(root / "first.json"),
+                    str(root / "second.json"),
+                    str(output),
+                ],
+                capture_output=True,
+                text=True,
+            )
+            self.assertEqual(p.returncode, 0, p.stderr)
+            with output.open(newline="", encoding="utf-8") as stream:
+                rows = list(csv.DictReader(stream))
+            self.assertEqual([r["op_type"] for r in rows], ["Add", "Sub"])
+            self.assertEqual(rows[0]["file_name"], "dynamic/add.py")

