+"""Actual implementation-mode CLI input failure and successful output controls."""
+
+import json
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+
+SCRIPT = (
+    Path(__file__).resolve().parents[3]
+    / "scripts/kernel/binary_script/gen_opc_json_with_impl_mode.py"
+)
+
+
+class TestImplModeInputStatus(unittest.TestCase):
+    def test_missing_input_is_not_successful(self):
+        with tempfile.TemporaryDirectory() as temporary:
+            root = Path(temporary)
+            output = root / "output.json"
+            result = subprocess.run(
+                [
+                    sys.executable,
+                    str(SCRIPT),
+                    str(root / "absent.json"),
+                    str(output),
+                    "high_performance",
+                ],
+                capture_output=True,
+                text=True,
+                check=False,
+            )
+            self.assertNotEqual(result.returncode, 0, result.stdout)
+            self.assertIn("ori_json doesnt exist", result.stdout)
+            self.assertFalse(output.exists())
+
+    def test_valid_input_preserves_metadata_and_adds_requested_mode(self):
+        with tempfile.TemporaryDirectory() as temporary:
+            root = Path(temporary)
+            source, output = root / "input.json", root / "output.json"
+            original = {
+                "op_type": "FixtureOp",
+                "op_list": [{"bin_filename": "kernel", "tag": 7}, {"tag": 8}],
+                "optional_input_mode": True,
+            }
+            source.write_text(json.dumps(original), encoding="utf-8")
+            result = subprocess.run(
+                [
+                    sys.executable,
+                    str(SCRIPT),
+                    str(source),
+                    str(output),
+                    "high_performance",
+                ],
+                capture_output=True,
+                text=True,
+                check=False,
+            )
+            self.assertEqual(result.returncode, 0, result.stderr)
+            expected = {
+                **original,
+                "op_list": [
+                    {"bin_filename": "kernel_high_performance", "tag": 7},
+                    {"tag": 8},
+                ],
+            }
+            self.assertEqual(json.loads(output.read_text(encoding="utf-8")), expected)
+            self.assertEqual(json.loads(source.read_text(encoding="utf-8")), original)
+
+    def test_empty_task_list_remains_supported(self):
+        with tempfile.TemporaryDirectory() as temporary:
+            root = Path(temporary)
+            source, output = root / "input.json", root / "output.json"
+            original = {"op_type": "FixtureOp", "op_list": []}
+            source.write_text(json.dumps(original), encoding="utf-8")
+            result = subprocess.run(
+                [
+                    sys.executable,
+                    str(SCRIPT),
+                    str(source),
+                    str(output),
+                    "high_precision",
+                ],
+                capture_output=True,
+                text=True,
+                check=False,
+            )
+            self.assertEqual(result.returncode, 0, result.stderr)
+            self.assertEqual(json.loads(output.read_text(encoding="utf-8")), original)
+
+
+if __name__ == "__main__":
+    unittest.main()

