+# INCLUDING BUT NOT LIMITED TO NON-INFRINGEMENT, MERCHANTABILITY, OR FITNESS FOR A PARTICULAR PURPOSE.
+# See LICENSE in the root of the software repository for the full text of the License.
+# ----------------------------------------------------------------------------
+"""Actual splitter CLI for empty workloads and ordinary partitioning."""
+
+import json
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+
+SCRIPT = (
+    Path(__file__).resolve().parents[3]
+    / "scripts/kernel/binary_script/gen_opc_json_with_threadnum.py"
+)
+
+
+class TestEmptyOpcTasks(unittest.TestCase):
+    def run_case(self, original, parts):
+        with tempfile.TemporaryDirectory() as temporary:
+            source = Path(temporary) / "config.json"
+            source.write_text(json.dumps(original), encoding="utf-8")
+            result = subprocess.run(
+                [sys.executable, str(SCRIPT), str(source), str(parts)],
+                capture_output=True,
+                text=True,
+                check=False,
+            )
+            self.assertEqual(result.returncode, 0, result.stderr)
+            count = max(1, parts)
+            outputs = [
+                json.loads(
+                    Path(str(source) + "_" + str(index)).read_text(encoding="utf-8")
+                )
+                for index in range(count)
+            ]
+            self.assertTrue(all(x["op_type"] == "FixtureOp" for x in outputs))
+            self.assertEqual(
+                [entry for x in outputs for entry in x["op_list"]],
+                original.get("op_list", []),
+            )
+            if original.get("optional_input_mode"):
+                self.assertTrue(all(x["optional_input_mode"] is True for x in outputs))
+            self.assertEqual(json.loads(source.read_text(encoding="utf-8")), original)
+
+    def test_empty_workload_for_normalized_thread_counts(self):
+        for parts in (1, 3, 0, -2):
+            with self.subTest(parts=parts):
+                self.run_case(
+                    {
+                        "op_type": "FixtureOp",
+                        "op_list": [],
+                        "optional_input_mode": True,
+                    },
+                    parts,
+                )
+
+    def test_absent_op_list_keeps_the_existing_empty_default(self):
+        self.run_case({"op_type": "FixtureOp"}, 2)
+
+    def test_nonempty_partitioning_preserves_order_and_metadata(self):
+        for size, parts in ((5, 2), (2, 5), (1, 0)):
+            with self.subTest(size=size, parts=parts):
+                self.run_case(
+                    {
+                        "op_type": "FixtureOp",
+                        "op_list": [{"bin_filename": f"item_{i}"} for i in range(size)],
+                        "optional_input_mode": True,
+                    },
+                    parts,
+                )
+
+
+if __name__ == "__main__":
+    unittest.main()

